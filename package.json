{
  "name": "@davidmars/js-helpers",
  "version": "0.0.17",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "sideEffects": false,
  "files": [
    "/dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "check": "npm run build && npm run check:runtime && npm run check:consumers",
    "check:runtime": "node scripts/check-runtime-imports.mjs",
    "check:consumers": "node scripts/validate-consumers.mjs",
    "preview": "vite preview",
    "version patch & push": "npm version patch && git push --all",
    "publish-lib": "npm run build && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/davidmars/js-helpers.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "vite": "5.2.6",
    "vite-plugin-dts": "^1.7.3"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "filesize": "^10.1.0",
    "typescript": "^5.1.6"
  }
}
